   "source": [
    "cuisine_cols = ['south_indian_or_not','north_indian_or_not','fast_food_or_not',\n",
    "                'street_food','biryani_or_not','bakery_or_not']\n",
    "cuisine_labels = ['South Indian','North Indian','Fast Food','Street Food','Biryani','Bakery']\n",
    "\n",
    "cuisine_counts = india[cuisine_cols].sum().values\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 4))\n",
    "bars = ax.bar(cuisine_labels, cuisine_counts, color='#6aaa64', edgecolor='white')\n",
    "for bar, val in zip(bars, cuisine_counts):\n",
    "    ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 50,\n",
    "            f'{int(val):,}\\n({val/len(india)*100:.1f}%)',\n",
    "            ha='center', va='bottom', fontsize=9)\n",
    "ax.set_title('India — počet restaurací podle typu kuchyně (binární příznaky)')\n",
    "ax.set_ylabel('Počet restaurací')\n",
    "plt.tight_layout()\n",
    "plt.savefig('india_cuisine_types.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sample = india.sample(3000, random_state=42)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "sc = ax.scatter(sample['average_price'], sample['rating'],\n",
    "                alpha=0.25, s=12, color='#6aaa64')\n",
    "\n",
    "z = np.polyfit(india['average_price'], india['rating'], 1)\n",
    "p = np.poly1d(z)\n",
    "x_line = np.linspace(india['average_price'].min(), india['average_price'].max(), 200)\n",
    "ax.plot(x_line, p(x_line), color='darkgreen', lw=1.5,\n",
    "        linestyle='--', label=f'Trend (slope={z[0]:.5f})')\n",
    "ax.set_title('India — závislost hodnocení na ceně')\n",
    "ax.set_xlabel('Průměrná cena (INR)')\n",
