  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if MONGO_OK:\n",
    "    shard_primaries = {\n",
    "        'rs1': ('localhost', 27021),\n",
    "        'rs2': ('localhost', 27024),\n",
    "        'rs3': ('localhost', 27027),\n",
    "    }\n",
    "\n",
    "    print('Replication lag per shard secondary nodes:')\n",
    "    print(f'{\"Shard\":<6} {\"Member\":<25} {\"State\":<10} {\"Lag (s)\"}')\n",
    "    print('-' * 60)\n",
    "\n",
    "    lag_rows = []\n",
    "    for rs_name, (host, port) in shard_primaries.items():\n",
    "        try:\n",
    "            c = MongoClient(host=host, port=port,\n",
    "                            username='admin', password='RestCluster2024!',\n",
    "                            authSource='admin',\n",
    "                            serverSelectionTimeoutMS=2000)\n",
    "            status = c.admin.command('replSetGetStatus')\n",
    "            members = status.get('members', [])\n",
    "\n",
    "            primary_ts = None\n",
    "            for m in members:\n",
    "                if m.get('stateStr') == 'PRIMARY':\n",
    "                    primary_ts = m.get('optimeDate')\n",
    "                    break\n",
    "\n",
    "            for m in members:\n",
    "                state = m.get('stateStr', '?')\n",
    "                member_ts = m.get('optimeDate')\n",
    "                if primary_ts and member_ts and state == 'SECONDARY':\n",
    "                    lag = (primary_ts - member_ts).total_seconds()\n",
    "                else:\n",
    "                    lag = None\n",
    "\n",
    "                lag_rows.append({\n",
    "                    'shard': rs_name,\n",
    "                    'member': m.get('name'),\n",
    "                    'state': state,\n",
    "                    'lag_s': lag,\n",
    "                })\n",
    "                lag_str = f'{lag:.1f}s' if lag is not None else 'N/A'\n",
    "                print(f'{rs_name:<6} {m.get(\"name\", \"\"):<25} {state:<10} {lag_str}')\n",
    "            c.close()\n",
    "        except Exception as e:\n",
    "            print(f'{rs_name}: could not connect via {host}:{port} — {e}')\n",
    "\n",
    "    if lag_rows:\n",
    "        lag_df = pd.DataFrame(lag_rows)\n",
    "        sec_df = lag_df[lag_df['state'] == 'SECONDARY'].dropna(subset=['lag_s'])\n",
    "        if not sec_df.empty:\n",
    "            fig, ax = plt.subplots(figsize=(10, 4))\n",
    "            colors_map = {'rs1': '#e07b54', 'rs2': '#5b8db8', 'rs3': '#6aaa64'}\n",
    "            bar_colors = [colors_map.get(r, 'gray') for r in sec_df['shard']]\n",
    "            ax.bar(sec_df['member'], sec_df['lag_s'],\n",
    "                   color=bar_colors, edgecolor='white')\n",
    "            ax.set_title('Replikační lag na secondary uzlech (sekundy)')\n",
    "            ax.set_ylabel('Lag (s)')\n",
    "            ax.set_xlabel('Uzel')\n",
    "            plt.xticks(rotation=20, ha='right')\n",
    "            plt.tight_layout()\n",
    "            plt.savefig('mongo_replication_lag.png', bbox_inches='tight')\n",
    "            plt.show()"
   ]
  },
