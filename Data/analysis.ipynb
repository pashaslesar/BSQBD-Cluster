    "pivot.plot(kind='bar', stacked=True, figsize=(12, 5),\n",
    "           colormap='tab10', edgecolor='white')\n",
    "plt.title('USA — top 8 řetězců v top 5 státech')\n",
    "plt.xlabel('Stát')\n",
    "plt.ylabel('Počet poboček')\n",
    "plt.xticks(rotation=0)\n",
    "plt.legend(bbox_to_anchor=(1.01, 1), loc='upper left', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig('usa_chains_by_state.png', bbox_inches='tight')\n",
