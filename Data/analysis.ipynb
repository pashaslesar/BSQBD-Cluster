   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "top5_states = usa['province'].value_counts().head(5).index\n",
    "top5_chains = usa['name'].value_counts().head(8).index\n",
    "\n",
    "pivot = (usa[usa['province'].isin(top5_states) & usa['name'].isin(top5_chains)]\n",
