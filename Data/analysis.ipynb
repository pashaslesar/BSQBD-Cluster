    "axes[1].set_ylabel('Počet restaurací')\n",
    "axes[1].axvline(india['average_price'].mean(), color='darkgreen', lw=1.5,\n",
    "                linestyle='--', label=f'Mean: {india[\"average_price\"].mean():.0f} INR')\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('india_rating_price.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
