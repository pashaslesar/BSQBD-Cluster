   "source": [
    "# Restaurant Data Analysis\n",
    "**Semestrální projekt — MongoDB Sharded Cluster**\n",
    "\n",
    "Analýza tří datasetů restaurací:\n",
    "- `dubai-restaurants.csv` — 7 342 restaurací v Dubaji (Tour-Pedia)\n",
    "- `fastfood-usa-restaurants.csv` — 9 999 rychlého občerstvení v USA\n",
    "- `indian-restaurants.csv` — 27 656 restaurací v Indii\n",
    "\n",
    "**Celkem: 45 000 záznamů**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "plt.rcParams['figure.dpi'] = 110\n",
    "plt.rcParams['figure.figsize'] = (12, 4)\n",
    "plt.rcParams['axes.spines.top'] = False\n",
    "plt.rcParams['axes.spines.right'] = False\n",
    "\n",
    "print('Libraries loaded.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. Načtení dat"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dubai  = pd.read_csv('dubai-restaurants.csv')\n",
    "usa    = pd.read_csv('fastfood-usa-restaurants.csv')\n",
    "india  = pd.read_csv('indian-restaurants.csv', encoding='utf-8-sig')\n",
    "\n",
    "india = india.rename(columns=lambda c: c.strip().replace(" ", ""))\n",
    "\n",
    "print(f'Dubai:  {len(dubai):>6} rows  |  {dubai.shape[1]} columns')\n",
    "print(f'USA:    {len(usa):>6} rows  |  {usa.shape[1]} columns')\n",
    "print(f'India:  {len(india):>6} rows  |  {india.shape[1]} columns')\n",
    "print(f'Total:  {len(dubai)+len(usa)+len(india):>6} rows')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. Přehled schémat"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== DUBAI columns ===')\n",
    "print(dubai.dtypes.to_string())\n",
    "print()\n",
    "print('=== USA columns ===')\n",
    "print(usa.dtypes.to_string())\n",
    "print()\n",
    "print('=== INDIA columns ===')\n",
    "print(india.dtypes.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== DUBAI — first 3 rows ===')\n",
    "display(dubai.head(3))\n",
    "print('=== USA — first 3 rows ===')\n",
    "display(usa.head(3))\n",
    "print('=== INDIA — first 3 rows ===')\n",
    "display(india.head(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Prázdné hodnoty (missing data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def missing_report(df, name):\n",
    "    total = len(df)\n",
    "    miss  = df.isnull().sum()\n",
    "    pct   = (miss / total * 100).round(2)\n",
    "    report = pd.DataFrame({'missing': miss, 'pct_%': pct})\n",
    "    report = report[report['missing'] > 0].sort_values('missing', ascending=False)\n",
    "    print(f'\\n--- {name} ({total} rows) ---')\n",
    "    if report.empty:\n",
    "        print('  No missing values.')\n",
    "    else:\n",
    "        print(report.to_string())\n",
    "\n",
    "missing_report(dubai,  'DUBAI')\n",
    "missing_report(usa,    'USA')\n",
    "missing_report(india,  'INDIA')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "for ax, (df, name, color) in zip(axes, [\n",
    "    (dubai, 'Dubai',  '#e07b54'),\n",
    "    (usa,   'USA',    '#5b8db8'),\n",
    "    (india, 'India',  '#6aaa64'),\n",
    "]):\n",
    "    miss = (df.isnull().sum() / len(df) * 100)\n",
    "    miss = miss[miss > 0].sort_values(ascending=True)\n",
    "    if miss.empty:\n",
    "        ax.text(0.5, 0.5, 'No missing\\nvalues', ha='center', va='center',\n",
    "                fontsize=13, transform=ax.transAxes)\n",
    "        ax.set_title(name)\n",
    "        ax.axis('off')\n",
    "    else:\n",
    "        miss.plot(kind='barh', ax=ax, color=color, edgecolor='white')\n",
    "        ax.set_xlabel('% missing')\n",
    "        ax.set_title(f'{name} — missing values')\n",
    "        ax.xaxis.set_major_formatter(mticker.PercentFormatter())\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('missing_values.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
