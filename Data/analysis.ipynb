  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if MONGO_OK:\n",
    "    cfg = client['config']\n",
    "    pipeline = [\n",
    "        {'$group': {'_id': '$shard', 'chunks': {'$sum': 1}}},\n",
    "        {'$sort':  {'_id': 1}}\n",
    "    ]\n",
    "    chunk_dist = list(cfg['chunks'].aggregate(pipeline))\n",
    "\n",
    "    if chunk_dist:\n",
    "        shards  = [d['_id'] for d in chunk_dist]\n",
    "        chunks  = [d['chunks'] for d in chunk_dist]\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(8, 4))\n",
    "        ax.bar(shards, chunks, color='#7b68ee', edgecolor='white')\n",
    "        for i, v in enumerate(chunks):\n",
    "            ax.text(i, v + 0.1, str(v), ha='center', fontsize=11, fontweight='bold')\n",
    "        ax.set_title('Distribuce chunků napříč shardy (config.chunks)')\n",
    "        ax.set_ylabel('Počet chunků')\n",
    "        ax.set_xlabel('Shard')\n",
    "        plt.tight_layout()\n",
    "        plt.savefig('mongo_chunk_distribution.png', bbox_inches='tight')\n",
    "        plt.show()\n",
    "\n",
    "        print('Chunk distribution:')\n",
    "        for s, c in zip(shards, chunks):\n",
    "            print(f'  {s}: {c} chunks')\n",
    "    else:\n",
