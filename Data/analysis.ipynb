    "    fig, ax = plt.subplots(figsize=(8, 4))\n",
    "    col_labels = ['Dubai\\nrestaurants', 'USA\\nfast food', 'Indian\\nrestaurants']\n",
    "    ax.bar(col_labels, counts.values(),\n",
    "           color=['#e07b54','#5b8db8','#6aaa64'], edgecolor='white')\n",
    "    for i, v in enumerate(counts.values()):\n",
    "        ax.text(i, v + 100, f'{v:,}', ha='center', fontsize=10, fontweight='bold')\n",
    "    ax.set_title('MongoDB — počet dokumentů v kolekcích')\n",
