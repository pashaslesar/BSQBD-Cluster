  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    from pymongo import MongoClient\n",
    "    client = MongoClient('mongodb://admin:RestCluster2024!@localhost:27017/?authSource=admin',\n",
    "                         serverSelectionTimeoutMS=4000)\n",
    "    client.admin.command('ping')\n",
    "    db  = client['restaurants']\n",
    "    cfg = client['config']\n",
    "\n",
    "    collections = ['dubai_restaurants','usa_fastfood','indian_restaurants']\n",
    "    counts = {c: db[c].estimated_document_count() for c in collections}\n",
    "    print('=== Počty dokumentů v kolekcích ===')\n",
    "    for c,n in counts.items():\n",
    "        print(f'  {c}: {n:,}')\n",
    "\n",
    "    chunk_cfg = cfg['settings'].find_one({'_id': 'chunksize'})\n",
    "    chunk_size_mb = chunk_cfg['value'] if chunk_cfg else 128\n",
    "    print(f'\\n=== Nastavení velikosti chunku: {chunk_size_mb} MB ===')\n",
    "\n",
    "    pipeline = [{'$group':{'_id':'$shard','chunks':{'$sum':1}}},{'$sort':{'_id':1}}]\n",
    "    chunk_dist = list(cfg['chunks'].aggregate(pipeline))\n",
    "    if chunk_dist:\n",
    "        print('\\n=== Distribuce chunků napříč shardy ===')\n",
    "        for d in chunk_dist:\n",
    "            print(f'  {d[\"_id\"]}: {d[\"chunks\"]} chunků  (~{d[\"chunks\"] * int(chunk_size_mb)} MB max)')\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(8, 4))\n",
    "        shards = [d['_id'] for d in chunk_dist]\n",
    "        chunks = [d['chunks'] for d in chunk_dist]\n",
    "        ax.bar(shards, chunks, color='#7b68ee', edgecolor='white')\n",
    "        for i,v in enumerate(chunks):\n",
    "            ax.text(i, v+0.1, str(v), ha='center', fontsize=11, fontweight='bold')\n",
    "        ax.set_title('Distribuce chunků napříč shardy', fontsize=12, fontweight='bold')\n",
    "        ax.set_ylabel('Počet chunků')\n",
    "        fig.text(0.5, -0.04,\n",
    "            f'Chunk size = {chunk_size_mb} MB.  '\n",
    "            f'Celkem {sum(chunks)} chunků rozdělených mezi {len(shards)} shardy.  '\n",
    "            'Hashed sharding zajistil vyváženou distribuci.',\n",
    "            ha='center', fontsize=9, color='#555')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    print('\\n=== Statistiky kolekcí ===')\n",
    "    stats_rows = []\n",
    "    for col in collections:\n",
    "        s = db.command('collStats', col)\n",
    "        stats_rows.append({'collection': col,\n",
    "                           'dokumentů': s.get('count',0),\n",
    "                           'dataSize_MB': round(s.get('size',0)/1024**2, 2),\n",
    "                           'storageSize_MB': round(s.get('storageSize',0)/1024**2, 2),\n",
    "                           'avgObjSize_B': round(s.get('avgObjSize',0), 1),\n",
    "                           'indexů': s.get('nindexes',0)})\n",
    "    stats_df = pd.DataFrame(stats_rows).set_index('collection')\n",
    "    display(stats_df)\n",
    "\n",
    "    print('\\n=== Replication lag na sekundárních uzlech ===')\n",
    "    rs_status = client.admin.command('replSetGetStatus')\n",
    "    primary_ts = None\n",
    "    for member in rs_status.get('members', []):\n",
    "        if member.get('stateStr') == 'PRIMARY':\n",
    "            primary_ts = member.get('optimeDate')\n",
    "    for member in rs_status.get('members', []):\n",
    "        if member.get('stateStr') == 'SECONDARY':\n",
    "            lag = (primary_ts - member['optimeDate']).total_seconds() if primary_ts else 'N/A'\n",
    "            print(f'  {member[\"name\"]:30} lag = {lag} s')\n",
    "\n",
    "    client.close()\n",
    "except Exception as e:\n",
    "    print(f'[info] MongoDB cluster není dostupný: {e}')\n",
    "    print('[info] Spusťte analýzu po startu clusteru: docker compose up -d')\n",
    "\n",
    "print('\\n✓ Analýza dokončena.')"
   ]
