   "metadata": {},
   "source": [
    "---\n",
    "## 5. Dubai — analýza kategorií a sentimentu"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "top_cat = dubai['category'].value_counts().head(15)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "top_cat.sort_values().plot(kind='barh', ax=ax, color='#e07b54', edgecolor='white')\n",
    "ax.set_title('Dubai — Top 15 kategorií restaurací')\n",
    "ax.set_xlabel('Počet restaurací')\n",
    "for bar in ax.patches:\n",
    "    ax.text(bar.get_width() + 5, bar.get_y() + bar.get_height()/2,\n",
    "            f'{int(bar.get_width())}', va='center', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig('dubai_categories.png', bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f'Unique categories: {dubai[\"category\"].nunique()}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "top_sub = dubai['subCategory'].dropna().value_counts().head(15)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "top_sub.sort_values().plot(kind='barh', ax=ax, color='#c0602e', edgecolor='white')\n",
    "ax.set_title('Dubai — Top 15 subkategorií')\n",
    "ax.set_xlabel('Počet restaurací')\n",
    "plt.tight_layout()\n",
    "plt.savefig('dubai_subcategories.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "dubai['polarity'].plot(kind='hist', bins=40, ax=axes[0],\n",
    "                        color='#e07b54', edgecolor='white')\n",
    "axes[0].set_title('Dubai — distribuce polarity (sentimentu)')\n",
    "axes[0].set_xlabel('Polarity score')\n",
    "axes[0].set_ylabel('Počet restaurací')\n",
    "\n",
    "pol_stats = dubai['polarity'].describe()\n",
    "axes[1].axis('off')\n",
    "stats_text = '\\n'.join([f'{k}: {v:.3f}' for k, v in pol_stats.items()])\n",
    "axes[1].text(0.1, 0.5, f'Statistiky polarity:\\n\\n{stats_text}',\n",
    "             transform=axes[1].transAxes, fontsize=11, va='center',\n",
    "             bbox=dict(boxstyle='round', facecolor='#fde8dc', alpha=0.6))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('dubai_polarity.png', bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "neg = (dubai['polarity'] < 0).sum()\n",
    "zero = (dubai['polarity'] == 0).sum()\n",
    "pos = (dubai['polarity'] > 0).sum()\n",
    "print(f'Negative polarity: {neg}  ({neg/len(dubai)*100:.1f}%)')\n",
    "print(f'Zero polarity:     {zero}  ({zero/len(dubai)*100:.1f}%)')\n",
    "print(f'Positive polarity: {pos}  ({pos/len(dubai)*100:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "top10_cats = dubai['category'].value_counts().head(10).index\n",
    "pol_by_cat = (dubai[dubai['category'].isin(top10_cats)]\n",
    "              .groupby('category')['polarity']\n",
    "              .agg(['mean','count'])\n",
    "              .sort_values('mean', ascending=True))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "colors = ['#d64c21' if v < 0 else '#e07b54' for v in pol_by_cat['mean']]\n",
    "pol_by_cat['mean'].plot(kind='barh', ax=ax, color=colors, edgecolor='white')\n",
    "ax.axvline(0, color='black', lw=0.8)\n",
    "ax.set_title('Dubai — průměrná polarita podle kategorie (top 10)')\n",
    "ax.set_xlabel('Průměrná polarita')\n",
    "plt.tight_layout()\n",
    "plt.savefig('dubai_polarity_by_category.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(10, 7))\n",
    "sc = ax.scatter(dubai['lng'], dubai['lat'],\n",
    "                c=dubai['polarity'], cmap='RdYlGn',\n",
    "                s=4, alpha=0.5, vmin=-1, vmax=1)\n",
    "plt.colorbar(sc, ax=ax, label='Polarity')\n",
    "ax.set_title('Dubai — rozmístění restaurací (lat/lng), barva = polarity)')\n",
    "ax.set_xlabel('Longitude')\n",
    "ax.set_ylabel('Latitude')\n",
    "plt.tight_layout()\n",
    "plt.savefig('dubai_geo.png', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
